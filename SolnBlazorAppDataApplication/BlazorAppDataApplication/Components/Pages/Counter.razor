@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>
<h2> This page is to show standard counter functionality</h2>

<div class="row">
    <div class="offset-4 col-md-2">
        <label for="counter">Initial counter value</label>
    </div>
    <div class="col-md-2">
        <input type="number" id="counter" @bind="@currentCount"
               placeholder="eg: 1" 
               style="width:85px;" />
    </div>
</div>

<p role="status">Current count: @currentCount</p>


<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
        if (currentCount == 50)
        {
            currentCount = 0;
        }
    }
}
